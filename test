import { expect } from "@playwright/test";
import { When, Then } from "../../../fixture.spec";
import { member } from "../../../../test_data/variables/member.variable";
import { url } from "../../../../test_data/url";
import { cart } from "../../../../test_data/variables/cart.variable";
import { cashier_menu } from "../../../../test_data/variables/cashier.variable";
import {
  calculateDate21YearsAgo,
  generateId,
  generateRandomPhoneNumber,
} from "../../../../../src/helpers/utils";

type SpecialEventMember =
  | "special event"
  | "special event database"
  | "survey limit"
  | "special event monthly limit";
type MemberCredential = { email: string; phone: string };

// XP balance and member captured before the survey, compared after submission.
// Tests run with a single worker per feature, so module state is safe here.
let xpBeforeSurvey = 0;
let currentMember: MemberCredential = member.iqos.special_event;

// A member can fill the survey only once per day, so each scenario registers
// its own fresh IQOS member through the UI (per Surya's direction).
const registeredMembers: Partial<Record<SpecialEventMember, MemberCredential>> =
  {};

function resolveMember(memberType: SpecialEventMember): MemberCredential {
  if (registeredMembers[memberType]) {
    return registeredMembers[memberType];
  }

  switch (memberType) {
    case "special event database":
      return member.iqos.special_event_db;

    case "special event monthly limit":
      return member.iqos.special_event;

    default:
      return member.iqos.special_event;
  }
}

    When(
      "User prepares an existing IQOS member for monthly limit test",
      async function ({ page, cashierPage, iqosXpPage }) {
        currentMember = resolveMember(
          "special event monthly limit",
        );

        console.log(
          `[MONTHLY LIMIT] Using existing member: ${currentMember.email} / ${currentMember.phone}`,
        );

        await page.goto(`${url.base_url}kasir`, {
          waitUntil: "domcontentloaded",
        });

        await page.waitForURL(/\/kasir/, {
          timeout: 30000,
        });

        await cashierPage.partnerProgramButton.waitFor({
          state: "visible",
          timeout: 30000,
        });

        await cashierPage.partnerProgramButton.click();

        await page.waitForTimeout(1000);
        await page.reload();
        await page.waitForTimeout(5000);

        await iqosXpPage.openMemberSearchForm();
        await searchCurrentMember(iqosXpPage);

        xpBeforeSurvey = await iqosXpPage.getMemberXp();

        console.log(
          `[MONTHLY LIMIT] XP before survey: ${xpBeforeSurvey}`,
        );
      },
    );

When(
  "User registers a new IQOS member for {string}",
  async function (
    { page, cashierPage, cartPage, memberPage },
    memberType: SpecialEventMember,
  ) {
    // Start from a clean Kasir page so leftover dialogs don't block the cart.
    // Explicitly wait for page URL and product search to be ready after any prior page.reload().
    await page.goto(`${url.base_url}kasir`, { waitUntil: "domcontentloaded" });
    await page.waitForURL(/\/kasir/, { timeout: 30000 });
    
    const isMonthlyLimit = memberType === "special event monthly limit";
    // Quick check if product already in cart (no timeout). If not, add it.
    if (!(await cashierPage.continueToTransactionButton.isVisible())) {
      await cashierPage.addSFPProductToCart();
    }
    await cashierPage.openCart();
    await memberPage.clickRegisterNewAccount();

    // "test..." emails are rejected by the survey as non-permanent
    // ("gunakan email permanen"), so use a plain name-style address.
    const id = generateId().replace(/\D/g, "");
    const newMember = {
      name: `Special Event ${id}`,
      email: `specialevent.qa${id}@sampoerna.com`,
      phone: generateRandomPhoneNumber(),
      gender: "male" as const,
      dateOfBirth: calculateDate21YearsAgo(),
      smokerStatus: "Non-Perokok",
    };
    await memberPage.fillAllRequiredFields(newMember, "Bebas Asap");
    // The IQOS edit button only shows once the member is saved to the cart.
    await cartPage.editIQOSButton.waitFor({ state: "visible", timeout: 15000 });
    // The member only exists after the transaction is completed.
    // backToHome=true (default): go back to home after first transaction.
    await cartPage.completeTransactionForNewMember(
      cart.codentify.valid,
      cart.approval_code.valid,
      true, // return to home
    );
    if (isMonthlyLimit) xpBeforeSurvey = 0; // brand new member

    registeredMembers[memberType] = {
      email: newMember.email,
      phone: newMember.phone,
    };
    // No separate search step in the cart flow; the XP check uses this member.
    if (isMonthlyLimit) currentMember = registeredMembers[memberType];
    console.log(
      `[SPECIAL EVENT] Registered new member for "${memberType}": ${newMember.email} / ${newMember.phone}`,
    );
  },
);

async function searchCurrentMember(iqosXpPage) {
  await iqosXpPage.searchAndSubmit(currentMember.email, currentMember.phone);
}

When(
  "User searches the {string} member and records the current XP",
  async function ({ iqosXpPage }, memberType: SpecialEventMember) {
    currentMember = resolveMember(memberType);
    // Partner Program may reopen the previous scenario's member page.
    await iqosXpPage.openMemberSearchForm();
    await searchCurrentMember(iqosXpPage);
    xpBeforeSurvey = await iqosXpPage.getMemberXp();
    console.log(`[SPECIAL EVENT] XP before survey: ${xpBeforeSurvey}`);
  },
);

// Survey from the Partner Program menu always offers +1 XP.
When(
  "User completes the survey and chooses XP points",
  async function ({ iqosXpPage }) {
    // QA intermittently drops the survey request and shows "Koneksi Internet
    // Terputus"; the XP is then not granted. Dismiss it and retry the survey.
    const MAX_ATTEMPTS = 3;
    for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
      try {
        await completeSurveyOnce(iqosXpPage);
      } catch (error) {
        if (
          attempt === MAX_ATTEMPTS ||
          !(await iqosXpPage.dismissConnectionLostIfVisible())
        ) {
          throw error;
        }
        console.log(`[SURVEY] Attempt ${attempt} hit a connection error, retrying`);
        continue;
      }
      // The popup can also show right after the final confirm.
      if (!(await iqosXpPage.dismissConnectionLostIfVisible())) return;
      if (attempt === MAX_ATTEMPTS) {
        throw new Error("Survey kept failing with 'Koneksi Internet Terputus'");
      }
      console.log(`[SURVEY] Attempt ${attempt} ended with a connection error, retrying`);
    }
  },
);

// The success screen offers "Lanjutkan Survey" only for an existing member
// searched in the cart (not for a member registered in the same order), so
// the Rp 1.000.000 order is a second transaction for the registered member.
When(
  "User buys IQOS Test Iluma for the {string} member through the cart",
  async function (
    { page, cashierPage, cartPage },
    memberType: SpecialEventMember,
  ) {
    currentMember = resolveMember(memberType);
    await page.goto(`${url.base_url}kasir`, { waitUntil: "domcontentloaded" });
    if (await cashierPage.continueToTransactionButton.isVisible()) {
      await cartPage.removeAllProductsFromCart();
    }
    await cashierPage.addProductToCartByName(
      cashier_menu.search_product.sfp.iqos_test_iluma,
    );
    await cashierPage.openCart();
    for (const index of [0, 1]) {
      if (await cartPage.scanCodentifyButton(index).isVisible().catch(() => false)) {
        await cartPage.fillCodentify(cart.codentify.valid, index);
      }
    }
    await cartPage.fillMemberData(currentMember.email, currentMember.phone);
    await cartPage.selectPreviousCigaretteBrandIfShown();
    await cartPage.fillApprovalCode(cart.approval_code.valid);
    await cartPage.toggleHavButtonWithRetry();
    await cartPage.completeTransactionButton.click();
    // Stay on the success screen so the survey can be continued from there.
    await cartPage.backToHomeButton.waitFor({ state: "visible", timeout: 60000 });
  },
);

// Survey from the order success screen ("Lanjutkan Survey"): this is where the
// special event bonus (+200 XP) is offered.
When(
  "User continues the survey from the order success screen and chooses XP points",
  async function ({ cartPage, iqosXpPage }) {
    await completeSurveyFromCartCheckout(cartPage, iqosXpPage);
    if (await iqosXpPage.dismissConnectionLostIfVisible()) {
      throw new Error("Survey failed with 'Koneksi Internet Terputus', rerun");
    }
  },
);

/**
 * Complete survey from the cart checkout flow.
 * The success modal appears after checkout with "Lanjutkan Survey" button.
 * This flow grants the special event bonus (+200 XP).
 */
async function completeSurveyFromCartCheckout(cartPage, iqosXpPage) {
  // Click "Lanjutkan Survey" button on the order success modal
  const page = iqosXpPage.page;
  try {
    await cartPage.continueSurveyButton.waitFor({
      state: "visible",
      timeout: 30000,
    });
  } catch (error) {
    // Debug aid: show what the success screen offers instead.
    const buttons = await page
      .locator("button:visible, [id^='order-success-modal']")
      .evaluateAll((els) =>
        els.map((el) => `${el.id || "-"} | ${(el.textContent || "").trim()}`),
      )
      .catch(() => []);
    console.log(`[SURVEY][DEBUG] URL: ${page.url()}`);
    console.log(`[SURVEY][DEBUG] Visible buttons:\n  ${buttons.join("\n  ")}`);
    await page.screenshot({ path: "reports/cde-79943-success-screen.png" });
    throw error;
  }
  await cartPage.continueSurveyButton.click();
  await iqosXpPage.page.waitForTimeout(2000);

  // The survey question is randomized: it can be the Angular star-rating
  // dialog inside the Kasir iframe, or the Radix dialog on the page.
  const starSurvey = iqosXpPage.surveyStarRating.first();

  console.log(
    "[DEBUG] survey title visible:",
    await iqosXpPage.radixSurveyTitle.isVisible().catch(() => false),
  );

  console.log(
    "[DEBUG] radix dialog visible:",
    await iqosXpPage.radixSurveyDialog.isVisible().catch(() => false),
  );

  console.log(
    "[DEBUG] star survey visible:",
    await starSurvey.isVisible().catch(() => false),
  );

  await expect
    .poll(
      async () => {
        const surveyTitleVisible =
          await iqosXpPage.radixSurveyTitle
            .isVisible()
            .catch(() => false);

        const starVisible =
          await starSurvey
            .isVisible()
            .catch(() => false);

        const limitVisible =
          await iqosXpPage.surveyLimitToast
            .isVisible()
            .catch(() => false);

        if (limitVisible) {
          console.log(
            "[DEBUG] Survey limit reached",
          );
        }

        return (
          surveyTitleVisible ||
          starVisible ||
          limitVisible
        );
      },
      {
        timeout: 15000,
      },
    )
    .toBe(true);

  if (await iqosXpPage.surveyLimitToast.isVisible().catch(() => false)) {
    console.log("[SURVEY] Limit toast shown");
    return;
  }

  if (
    await iqosXpPage.radixSurveyTitle
      .isVisible()
      .catch(() => false)
  ) {
    await iqosXpPage.completeSurveySeveralQuestion();
  } else if (
    await starSurvey.isVisible().catch(() => false)
  ) {
    await iqosXpPage.completeSurveyStarRating();
  } else {
    throw new Error(
      "Survey modal appeared but automation could not identify survey type",
    );
  }
}

async function completeSurveyOnce(iqosXpPage) {
  await iqosXpPage.clickSurveyButton();
  // The survey question is randomized: it can be the Angular star-rating
  // dialog inside the Kasir iframe, or the Radix dialog on the page.
  const starSurvey = iqosXpPage.surveyStarRating.first();
  await expect(
    starSurvey
      .or(iqosXpPage.radixSurveyDialog)
      .or(iqosXpPage.surveyLimitToast),
  ).toBeVisible({ timeout: 15000 });
  if (await iqosXpPage.surveyLimitToast.isVisible().catch(() => false)) {
    // A previous attempt was actually saved before the connection dropped.
    console.log("[SURVEY] Limit toast shown, the earlier attempt was saved");
    return;
  }
  if (await starSurvey.isVisible()) {
    // Star rating -> consents -> Lanjutkan -> Poin -> confirm -> Ke Menu IQOS XP
    await iqosXpPage.completeSurveyStarRating();
  } else {
    // Answers every radio group and textarea, then picks "Poin" and confirms.
    await iqosXpPage.completeSurveySeveralQuestion();
  }
}

Then(
  "Member XP should be higher than before the survey",
  async function ({ iqosXpPage }) {
    // "Ke Menu IQOS XP" may land on the search form or on the member page.
    await iqosXpPage.page.waitForTimeout(3000);
    if (await iqosXpPage.emailField.isVisible().catch(() => false)) {
      await searchCurrentMember(iqosXpPage);
    }
    const xpAfter = await iqosXpPage.getMemberXp();
    console.log(
      `[SPECIAL EVENT] XP before: ${xpBeforeSurvey}, after: ${xpAfter}`,
    );
    expect(xpAfter).toBeGreaterThan(xpBeforeSurvey);
  },
);

Then(
  "Member XP should be capped at the monthly limit of {int} XP out of {int} XP",
  async function (
    { page, cashierPage, iqosXpPage },
    monthlyLimit: number,
    fullReward: number,
  ) {
    // Read XP from a fresh load so it reflects what the backend saved.
    await reopenCurrentMember(page, cashierPage, iqosXpPage);
    const xpAfter = await iqosXpPage.getMemberXp();
    const xpGained = xpAfter - xpBeforeSurvey;
    console.log(
      `[MONTHLY LIMIT] XP before: ${xpBeforeSurvey}, after: ${xpAfter}, gained: ${xpGained} (full reward ${fullReward}, limit ${monthlyLimit})`,
    );
    // Partial: the member got points, but only up to the limit, not the full reward.
    expect(xpGained).toBeGreaterThan(0);
    expect(xpGained).toBeLessThan(fullReward);
    expect(xpAfter).toBe(monthlyLimit);
  },
);

/**
 * Reopen Partner Program from a fresh page load so the XP shown comes from the
 * backend, not client state (same navigation as CDE-71312), then open the
 * current member's page.
 */
async function reopenCurrentMember(page, cashierPage, iqosXpPage) {
  await page.goto(`${url.base_url}kasir`, { waitUntil: "domcontentloaded" });
  await page.waitForURL(/kasir/, { timeout: 30000 });
  await cashierPage.partnerProgramButton.waitFor({
    state: "visible",
    timeout: 30000,
  });
  await cashierPage.partnerProgramButton.click();
  await page.waitForTimeout(1000);
  await page.reload();
  await page.waitForTimeout(5000);
  // After reload the app may restore the last member page directly.
  if (await iqosXpPage.emailField.isVisible().catch(() => false)) {
    await searchCurrentMember(iqosXpPage);
  }
}

// XP right after the first (accepted) survey, for CDE-79944.
let xpAfterFirstSurvey = 0;

When(
  "User opens the survey again for the same member",
  async function ({ page, cashierPage, iqosXpPage }) {
    await reopenCurrentMember(page, cashierPage, iqosXpPage);
    xpAfterFirstSurvey = await iqosXpPage.getMemberXp();
    console.log(
      `[SURVEY LIMIT] XP before survey: ${xpBeforeSurvey}, after first survey: ${xpAfterFirstSurvey}`,
    );
    await iqosXpPage.clickSurveyButton();
  },
);

Then(
  "System rejects the survey with the survey limit message",
  async function ({ iqosXpPage }) {
    // First survey was accepted, so the member really is at the limit now.
    expect(xpAfterFirstSurvey).toBeGreaterThan(xpBeforeSurvey);
    await iqosXpPage.verifySurveyLimitError();
  },
);

Then(
  "Member XP should not change after the rejected survey",
  async function ({ page, cashierPage, iqosXpPage }) {
    await reopenCurrentMember(page, cashierPage, iqosXpPage);
    const xpNow = await iqosXpPage.getMemberXp();
    console.log(
      `[SURVEY LIMIT] XP after first survey: ${xpAfterFirstSurvey}, after rejected survey: ${xpNow}`,
    );
    expect(xpNow).toBe(xpAfterFirstSurvey);
  },
);

Then(
  "Member XP should still be higher than before after reloading the page",
  async function ({ page, cashierPage, iqosXpPage }) {
    await reopenCurrentMember(page, cashierPage, iqosXpPage);
    const xpAfter = await iqosXpPage.getMemberXp();
    console.log(
      `[SPECIAL EVENT] XP before: ${xpBeforeSurvey}, after reload: ${xpAfter}`,
    );
    expect(xpAfter).toBeGreaterThan(xpBeforeSurvey);
  },
);
